upstream backend_server {
    server backend:5000;
}

server {
    listen 80;
    server_name {{ service_cfg.domain }};

    root /usr/share/nginx/html;
    index index.html;

    # Serve static files for the React app
    location / {
        try_files $uri /index.html;
    }

    # Proxy API requests (no changes here)
    location /api {
        proxy_pass http://backend_server;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /auth {
        proxy_pass http://backend_server;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Proxy WebSocket (Socket.IO) connections. These are long-lived and mostly
    # idle between log lines, so raise the read/send timeouts well above nginx's
    # 60s default (an idle disconnect mid-provision looks like "logs vanished"),
    # disable buffering so lines stream immediately, and forward the real client
    # info the backend's ProxyFix expects.
    location /socket.io {
        proxy_pass http://backend_server;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}