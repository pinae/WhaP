# --- Flask ---
# SECRET_KEY is now mandatory: the app has no in-source fallback and
# check_critical_config() refuses to start if it is missing or left at the old
# placeholder. Generate a strong random key:
#   python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY='{{ service_cfg.secret_key }}'
REACT_APP_API_BASE_URL=http://backend:5000

# --- Database (PostgreSQL) ---
DATABASE_URL='postgresql://{{ service_cfg.db.user }}:{{ service_cfg.db.password }}@db:5432/{{ service_cfg.db.name }}'
REDIS_HOST='redis'
REDIS_PORT=6379

PROJECT_STORAGE_DIR='/data/'
LOCAL_BASE_PATH='/home/'
DATASETS_BASE_PATH='/data/DATASETS'
DATASETS_LOCAL_BASE_PATH='/home/DATASETS'
DOCS_DIR='/backend/docs'
CONTAINER_FILE_OWNER='{{ service_cfg.container_file_owner | default("pina") }}'
DOCKER_REGISTRY='{{ service_cfg.whap_registry | default("") }}'

# --- InfluxDB ---
# No spaces around '=' — docker-compose env_file treats the whole line literally,
# so 'KEY = value' can leak spaces into the name/value (and INFLUX_TOKEN must be
# exact for the stats queries to authenticate).
INFLUX_URL='http://whap-influxdb:8086'
INFLUX_TOKEN='{{ service_cfg.influxdb.token }}'
INFLUX_ORG='{{ service_cfg.influxdb.org }}'
INFLUX_BUCKET='{{ service_cfg.influxdb.bucket }}'

# --- LDAP (RUB) ---
LDAP_SERVER_URI='{{ ldap.uri }}'
# The base DN where user accounts reside
LDAP_USER_BASE_DN='{{ ldap.base.dn }}'
LDAP_BIND_USER='{{ ldap.binduser.dn }}'
LDAP_BIND_PASSWORD='{{ ldap.binduser.password }}'
# Certificate verification for ldaps://: DEMAND, ALLOW or NEVER. It does not
# turn TLS on or off -- the URI scheme does (ldap:// is plaintext).
# DEMAND requires a valid server certificate. ALLOW and NEVER accept
# invalid/self-signed certs and expose the bind password (and user credentials)
# to a MITM, so keep DEMAND and set ldap.ca_cert_file for a private CA instead.
LDAP_TLS_OPTION='{{ ldap.tls_option | default("DEMAND") }}'
{% if ldap.ca_cert_file is defined %}
# Path inside the backend and worker containers.
LDAP_CA_CERT_FILE='{{ ldap.ca_cert_file }}'
{% endif %}
# objectClass of the person entries the user search lists (RUB: rubPerson).
LDAP_USER_OBJECT_CLASS='{{ ldap.user_object_class | default("rubPerson") }}'

# --- Ansible ---
# Absolute path to the directory where ansible-runner will store its data
ANSIBLE_RUNNER_DIR='/backend/ansible_runner'
ANSIBLE_CONTAINER_BASE_DIR='{{ docker_dir }}'
# Absolute path to the directory containing your Ansible roles
# (e.g., /home/user/ansible/roles or /etc/ansible/roles)
ANSIBLE_ROLES_PATH='/backend/roles{% for d in service_cfg.extra_role_dirs | default([]) %}:/backend/roles_extra/{{ loop.index }}{% endfor %}:/backend/roles_public'
ANSIBLE_PROJECT_DIR='/backend'
# ANSIBLE_RUNNER_QUIET=False # Uncomment for more verbose Ansible output
ANSIBLE_SSH_PRIVATE_KEY_FILE='/home/pina/.ssh/id_ed25519'

# --- CORS ---
# Only real browser origins belong here
CORS_ORIGINS='http://{{ service_cfg.domain }},https://{{ service_cfg.domain }}'

# --- Worker -> backend job updates (Redis) ---
# Worker-to-backend job updates flow through a Redis queue ('job_updates_queue'
# via run_job.py), not an internal HTTP endpoint, so the old INTERNAL_API_URL
# setting has been removed (it was also written with ':' instead of '=', so it
# never took effect).
#
# Socket.IO backplane: not required with the single web worker used here (all
# clients live on one process), but harmless and needed if you ever scale to
# multiple workers behind sticky sessions. Defaults to redis://$REDIS_HOST:$REDIS_PORT.
SOCKETIO_MESSAGE_QUEUE='redis://redis:6379'

# --- Session Cookies (Production Recommendations) ---
# The application defaults these to secure values; kept explicit for the
# HTTPS-terminating reverse-proxy deployment.
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE='Lax'
# Session lifetime in seconds (default 8h if unset).
PERMANENT_SESSION_LIFETIME=28800