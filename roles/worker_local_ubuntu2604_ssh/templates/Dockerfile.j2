FROM ubuntu:26.04 AS base

# Set environment variables for non-interactive installs and locale
ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=de_DE.utf8

# Update, install dependencies, and setup locale
RUN apt-get update && apt-get install -y --no-install-recommends \
      # System & Networking
      locales openssh-server vim iproute2 iputils-ping net-tools wget curl screen tmux sudo \
      # Python & Build Tools
      python3-pip python3-venv python3-numpy python3-ipython pipenv git build-essential cmake ccache sed \
      # System Tools
      software-properties-common gnupg2 \
    # Setup locale
    && localedef -i de_DE -c -f UTF-8 de_DE.UTF-8

# --- Install NVIDIA CUDA Toolkit ---
# The newest CUDA 13 and the cuDNN built for it, from NVIDIA's repository: the
# one for Ubuntu 26.04 if NVIDIA publishes it, else the 24.04 one (which the
# 25.10 image uses too). The build log says which.
# CUDA 13 runs with a host driver >= 580, on GPUs from Turing (RTX 20xx,
# T4) on; it no longer supports Maxwell, Pascal and Volta (GTX 10xx, V100).
# This is a large installation, so we give it its own layer.
# It will be cached unless the commands change.
WORKDIR /tmp
RUN for distro in ubuntu2604 ubuntu2404; do \
      wget -q "https://developer.download.nvidia.com/compute/cuda/repos/${distro}/x86_64/cuda-keyring_1.1-1_all.deb" \
        && echo "Using NVIDIA's CUDA repository for ${distro}" && break; \
    done \
    && dpkg -i cuda-keyring_1.1-1_all.deb \
    && rm cuda-keyring_1.1-1_all.deb \
    && apt-get update \
    && apt-get -y install cuda-toolkit-13 cudnn9-cuda-13 libnvidia-compute-580-server libgl-dev libvdpau-dev
RUN apt-get -y install nvtop

# Ubuntu's nvtop gives itself CAP_PERFMON (setcap in its postinst), for Intel
# GPUs' performance counters. Docker doesn't grant containers that capability,
# so the kernel refuses to run nvtop at all: "Operation not permitted". NVIDIA
# GPUs don't need it. Remove it, and again whenever apt reinstalls nvtop.
RUN echo 'DPkg::Post-Invoke { "if [ -e /usr/bin/nvtop ]; then setcap -r /usr/bin/nvtop 2>/dev/null || true; fi"; };' \
      > /etc/apt/apt.conf.d/99nvtop-without-capabilities \
    && setcap -r /usr/bin/nvtop

# nvcc and the other CUDA tools on the PATH: ENV for docker exec, profile.d
# for SSH logins, which don't see the image's ENV.
ENV PATH=/usr/local/cuda/bin:${PATH}
RUN echo 'export PATH=/usr/local/cuda/bin:$PATH' > /etc/profile.d/cuda.sh

# nvcc refuses host compilers newer than it knows. Compile a kernel now, so an
# image whose CUDA can't use 26.04's GCC 15 fails here rather than for users.
# (If it does: install g++-14 and set NVCC_CCBIN=g++-14 in /etc/environment.)
RUN printf '__global__ void k() {}\nint main() { k<<<1, 1>>>(); return 0; }\n' > /tmp/check.cu \
    && nvcc -o /tmp/check /tmp/check.cu \
    && rm /tmp/check /tmp/check.cu

# libnvidia-compute-580-server is installed, as in the 25.10 image, only so
# packages that depend on the NVIDIA driver's user-space libraries (libcuda,
# libnvidia-ml, ...) can be installed. At run time the NVIDIA container toolkit
# mounts the host's own, matching ones, but the image's copies can shadow them:
# an older host driver loses to the newer copy, and a host that keeps its
# libraries elsewhere (Arch: /usr/lib) loses to /usr/lib/x86_64-linux-gnu,
# searched first. CUDA and nvidia-smi then fail with "Driver/library version
# mismatch". Remove the image's copies so the host's are the only ones,
# whatever driver and distribution it runs. The packages stay installed for apt.
RUN dpkg-query -W -f '${Package}\n' 'libnvidia-*' 2>/dev/null \
      | xargs -r dpkg -L 2>/dev/null \
      | grep -E '/lib(cuda[a-z]*|nvidia-[^/]*)\.so[^/]*$' \
      | xargs -r rm -f \
    && ldconfig

# unminimize the system
#RUN apt-get install -y unminimize
#RUN echo "y\nY" | unminimize

COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

RUN mkdir -p /run/sshd

COPY nopasswd /etc/sudoers.d/nopasswd
RUN chmod 0440 /etc/sudoers.d/nopasswd

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
# Start OpenSSH
USER root
RUN ssh-keygen -A
EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]
