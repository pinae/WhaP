FROM nvcr.io/nvidia/pytorch:19.06-py3
WORKDIR /

RUN apt-get update && apt-get install -y locales && rm -rf /var/lib/apt/lists/* \
	&& localedef -i de_DE -c -f UTF-8 -A /usr/share/locale/locale.alias de_DE.UTF-8
ENV LANG=de_DE.utf8

RUN apt-get update && apt-get install -y openssh-server sudo vim iproute2 iputils-ping net-tools wget curl screen tmux git software-properties-common gnupg2

# SSH logins do not get the image's ENV, so PATH lost /opt/conda/bin: python
# was Ubuntu's Python 2, without torch, and venv had no ensurepip. Hand the
# image's environment to login shells.
RUN env | grep -E '^(PATH|LD_LIBRARY_PATH|LIBRARY_PATH|CUDA_[A-Z_]*|CUDNN_[A-Z_]*|NCCL_[A-Z_]*|NVIDIA_[A-Z_]*|PYTORCH_[A-Z_]*|PYTHONIOENCODING|LC_ALL|LANG)=' \
      | sed -E "s/^([^=]+)=(.*)$/export \1='\2'/" > /etc/profile.d/00-image-env.sh

COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

RUN mkdir -p /run/sshd

COPY nopasswd /etc/sudoers.d/nopasswd
RUN chmod 0440 /etc/sudoers.d/nopasswd

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
# Start OpenSSH
USER root
RUN ssh-keygen -A
EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]
