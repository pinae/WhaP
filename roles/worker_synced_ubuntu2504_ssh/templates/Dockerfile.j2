FROM ubuntu:25.04 AS ubuntu2504_cuda129

# Set environment variables for non-interactive installs and locale
ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=de_DE.utf8

# Update, install dependencies, and setup locale
RUN apt-get update && apt-get install -y --no-install-recommends \
      # System & Networking
      locales openssh-server vim iproute2 iputils-ping net-tools wget curl screen tmux sudo \
      # Python & Build Tools
      python3-pip python3-venv python3-numpy python3-ipython pipenv git build-essential cmake ccache sed \
      # System Tools
      software-properties-common gnupg2 \
    # Setup locale
    && localedef -i de_DE -c -f UTF-8 -A /usr/share/locale/locale.alias de_DE.UTF-8

# --- Install NVIDIA CUDA Toolkit ---
# This is a large installation, so we give it its own layer.
# It will be cached unless the commands change.
WORKDIR /tmp
RUN wget https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2404/x86_64/cuda-keyring_1.1-1_all.deb \
    && dpkg -i cuda-keyring_1.1-1_all.deb \
    && rm cuda-keyring_1.1-1_all.deb \
    && apt-get update \
    && apt-get -y install cuda-toolkit-12-9
RUN echo "\n\n\n\n\n2\n" | apt-get -y install nvidia-cudnn
RUN apt-get -y install nvtop

# The packages above bring the NVIDIA driver's user-space libraries (libcuda,
# libnvidia-ml, ... from libnvidia-compute-*), needed only to satisfy
# their dependencies. At run time the NVIDIA container toolkit mounts the
# host's own, matching ones, but the image's copies can shadow them: an older
# host driver loses to the newer copy, and a host that keeps its libraries
# elsewhere (Arch: /usr/lib) loses to /usr/lib/x86_64-linux-gnu, searched
# first. CUDA and nvidia-smi then fail with "Driver/library version mismatch".
# Remove the image's copies so the host's are the only ones, whatever driver
# and distribution it runs. The packages stay installed for apt.
RUN dpkg-query -W -f '${Package}\n' 'libnvidia-*' 2>/dev/null \
      | xargs -r dpkg -L 2>/dev/null \
      | grep -E '/lib(cuda[a-z]*|nvidia-[^/]*)\.so[^/]*$' \
      | xargs -r rm -f \
    && ldconfig

# Using a heredoc is slightly more robust than piping echo for multi-line input
#RUN (apt-get -y install nvidia-cudnn <<EOF
#2
#EOF
#)

# unminimize the system
#RUN apt-get install -y unminimize
#RUN echo "y\nY" | unminimize

# =================================================================
# --- Stage 2: Final Image                                      ---
# =================================================================
FROM ubuntu2504_cuda129

# Use ARG to define build-time variables. The Ansible script will
# pass values to these arguments.
ARG USERNAME={{ service_cfg.user }}
ARG USER_ID={{ service_cfg.user_id }}
ARG GROUP_ID={{ service_cfg.group_id }}
ARG PASSWORD={{ service_cfg.password }}
ARG USER_COMMENT="LDAP User {{ service_cfg.user }}"

# Configure SSH and create the user based on the build arguments
RUN echo "root:${PASSWORD}" | chpasswd \
    && sed -i 's/#PermitRootLogin prohibit-password/PermitRootLogin yes/' /etc/ssh/sshd_config \
    # First, check if a user with the target UID already exists and delete them.
    && if getent passwd ${USER_ID} > /dev/null; then \
        EXISTING_USER=$(getent passwd ${USER_ID} | cut -d: -f1); \
        echo "User with UID ${USER_ID} (${EXISTING_USER}) already exists. Deleting."; \
        deluser --remove-home ${EXISTING_USER}; \
    fi && \
    \
    # Check if a group with the target GID already exists and delete it.
    if getent group ${GROUP_ID} > /dev/null; then \
        EXISTING_GROUP=$(getent group ${GROUP_ID} | cut -d: -f1); \
        # Only delete if it's not the user's intended group name to avoid errors
        if [ "${EXISTING_GROUP}" != "${USERNAME}" ]; then \
            echo "Group with GID ${GROUP_ID} (${EXISTING_GROUP}) already exists. Deleting."; \
            delgroup ${EXISTING_GROUP}; \
        fi; \
    fi \
    && groupadd --gid ${GROUP_ID} ${USERNAME} \
    && useradd --uid ${USER_ID} --gid ${GROUP_ID} -m -s /bin/bash --comment "${USER_COMMENT}" ${USERNAME} \
    && echo "${USERNAME} ALL=(root) NOPASSWD:ALL" > /etc/sudoers.d/${USERNAME} \
    && chmod 0440 /etc/sudoers.d/${USERNAME} \
    && echo "${USERNAME}:${PASSWORD}" | chpasswd

# Copy additional sudoers configuration if it exists in your build context
# Ensure the 'nopasswd' file is present where you run 'docker build'
COPY nopasswd /etc/sudoers.d/nopasswd
RUN chmod 0440 /etc/sudoers.d/nopasswd

# Switch context to the new user's home directory
WORKDIR /home/${USERNAME}
USER ${USERNAME}

# Start OpenSSH
USER root
RUN ssh-keygen -A
EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]
