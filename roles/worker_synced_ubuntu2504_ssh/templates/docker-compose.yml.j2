{% set service_data = {
    'build': {
        'context': '/docker/worker_synced_ubuntu2504_ssh-' + service_cfg.user + '-' + service_cfg.project_name + '/build/',
        'dockerfile': 'Dockerfile',
        'args': {
            'USERNAME': service_cfg.user,
            'USER_ID': service_cfg.user_id,
            'GROUP_ID': service_cfg.group_id,
            'PASSWORD': service_cfg.password,
            'USER_COMMENT': service_cfg.user
        }
    },
    'runtime': 'nvidia',
    'ipc': 'host',
    'container_name': service_cfg.container_name,
    'restart': 'unless-stopped',
    'ports': ['22:22'],
    'environment': [
        'PROJECT=' + service_cfg.project,
        'SAFE_PROJECT_NAME=' + service_cfg.project_name
    ],
    'deploy': {
        'resources': {
            'reservations': {
                'devices': [{
                    'driver': 'nvidia',
                    'device_ids': service_cfg.gpus,
                    'capabilities': ['compute', 'utility']
                }]
            }
        }
    },
    'mac_address': service_cfg.mac_address,
    'networks': {
        service_cfg.network: {
            'ipv4_address': service_cfg.ip_address
        }
    },
    'labels': [
        'com.centurylinklabs.watchtower.enable=false'
    ],
    'healthcheck': {
        'test': ['CMD-SHELL', 'netstat -nlp | grep -E ":22\\s+\\S*\\s+LISTEN\\s+\\S*sshd" > /dev/null'],
        'interval': '5s',
        'timeout': '5s',
        'retries': 5
    }
} %}

{# --- Volumes --- #}
{# Start with base volume #}
{% set vol_list = ['/data/' + service_cfg.user + '/' + service_cfg.project_name + '/:/home/' + service_cfg.user + ':rw'] %}
{# Append additional volumes if present #}
{% if service_cfg.additional_volumes is defined and service_cfg.additional_volumes %}
  {% for vol in service_cfg.additional_volumes %}
    {% set _ = vol_list.append(vol) %}
  {% endfor %}
{% endif %}
{% set _ = service_data.update({'volumes': vol_list}) %}

{# --- CPU Limits --- #}
{% if service_cfg.cpu_limit is defined and service_cfg.cpu_limit is not none %}
  {# Ensure limits dict exists (it does by default above, but good practice if structure changes) #}
  {% if 'limits' not in service_data['deploy']['resources'] %}
     {% set _ = service_data['deploy']['resources'].update({'limits': {}}) %}
  {% endif %}
  {% set _ = service_data['deploy']['resources']['limits'].update({'cpus': service_cfg.cpu_limit | string}) %}
{% endif %}

{# --- Final Structure --- #}
{% set compose_file = {
    'name': service_cfg.container_name,
    'services': {
        service_cfg.container_name: service_data
    },
    'networks': {
        service_cfg.network: {
            'external': true
        }
    }
} %}

{{ compose_file | to_nice_yaml(indent=2) }}
