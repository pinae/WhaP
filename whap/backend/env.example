# Development configuration for the backend and the worker.
#
# Copy to .env in this directory (whap/backend/.env) -- config.py loads it
# from there. The relative paths below assume you run `python run.py` and
# `python worker.py` from whap/backend, which is what the README describes.
#
# Never reuse these values in a deployment. Production .env.prod is generated
# by the Ansible `whap` role from your private inventory.

# --- Flask ---
# Enables the Werkzeug reloader in run.py. Must stay false anywhere real:
# the debugger exposes an interactive console.
FLASK_DEBUG=true
SECRET_KEY=dev-only-key-not-for-any-deployment

# --- Data stores (started by ../../docker-compose.yml) ---
DATABASE_URL=postgresql://whap_user:whap_dev_password@localhost:5432/whap_db
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Ansible ---
# ANSIBLE_ROLES_PATH must point at an existing directory or the config check
# refuses to start. Add your private roles with a colon separator if you have
# a site repository checked out alongside.
ANSIBLE_ROLES_PATH=../../roles
ANSIBLE_PROJECT_DIR=../..
ANSIBLE_RUNNER_DIR=../../.ansible_runner
ANSIBLE_CONTAINER_BASE_DIR=/docker
# Only needed if you have a compute host to talk to. Use an absolute path;
# '~' is not expanded.
#ANSIBLE_SSH_PRIVATE_KEY_FILE=/home/you/.ssh/id_ed25519

# --- Paths ---
DOCS_DIR=./docs
PROJECT_STORAGE_DIR=../../.dev_data/projects
LOCAL_BASE_PATH=../../.dev_data/home
DATASETS_BASE_PATH=../../.dev_data/projects/DATASETS
DATASETS_LOCAL_BASE_PATH=../../.dev_data/home/DATASETS

# --- Container images ---
# Empty means images are built locally instead of pulled from a registry.
DOCKER_REGISTRY=
CONTAINER_FILE_OWNER=root

# --- LDAP ---
# No directory server locally, but the config check requires these two to be
# set. LDAP logins will fail; local users (flask create-admin) work.
LDAP_SERVER_URI=ldaps://ldap.example.com:636
LDAP_USER_BASE_DN=ou=people,dc=example,dc=com
# Certificate verification for ldaps:// only: DEMAND, ALLOW or NEVER.
LDAP_TLS_OPTION=DEMAND
#LDAP_CA_CERT_FILE=/path/to/private-ca.pem
# Person objectClass for the user search: rubPerson at RUB, inetOrgPerson in a
# stock OpenLDAP.
LDAP_USER_OBJECT_CLASS=rubPerson

# --- Session cookies ---
# Development runs over plain HTTP. With the default SESSION_COOKIE_SECURE=True
# the browser would never send the cookie back and every login would fail.
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_SAMESITE=Lax
CORS_ORIGINS=http://localhost:3000
